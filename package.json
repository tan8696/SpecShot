{
  "name": "specshot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^18.18.0 || ^19.8.0 || >=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev",
    "build": "npm run validate:strict && node scripts/copy-pdf-worker.mjs && next build",
    "start": "npx serve@latest out",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-specs.mjs",
    "validate:strict": "node scripts/validate-specs.mjs --strict",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vercel/analytics": "^2.0.1",
    "heic2any": "^0.0.4",
    "next": "^15.0.0",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
